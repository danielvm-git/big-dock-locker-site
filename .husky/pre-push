#!/bin/sh
# Guard git: block direct push to main/master unless a sanctioned landing script is running.
#
# husky's `.husky/_/h` shim runs every hook with `sh -e`, and on Debian/Ubuntu
# that `sh` is dash. Keep this file POSIX so the guard cannot fail to parse on
# CI (BUG-001).
#
# Exempt a push by exporting GIT_BIGPOWERS_LAND=1, as scripts/land-branch.sh and
# the Release workflow do.

while read -r _local_ref _local_oid remote_ref _remote_oid; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      if [ "${GIT_BIGPOWERS_LAND:-0}" != "1" ]; then
        echo "ERROR: Direct push to protected branch '$remote_ref' is blocked by guard-git." >&2
        echo "Use 'bash scripts/land-branch.sh <branch>' or open a PR." >&2
        exit 1
      fi
      ;;
  esac
done

exit 0
