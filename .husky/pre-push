#!/usr/bin/env bash
# Guard git: block direct push to main/master unless land-branch script is running

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

while read local_ref local_oid remote_ref remote_oid
do
  if [[ "$remote_ref" =~ refs/heads/(main|master) ]]; then
    if [[ "${GIT_BIGPOWERS_LAND:-0}" != "1" ]]; then
      echo "ERROR: Direct push to protected branch '$remote_ref' is blocked by guard-git."
      echo "Use 'bash scripts/land-branch.sh <branch>' or open a PR."
      exit 1
    fi
  fi
done

exit 0
